{
  "name": "@signalwerk/minicms",
  "version": "0.1.0",
  "private": true,
  "description": "A configuration-driven, file-based content editor.",
  "type": "module",
  "exports": {
    "./core/content": "./core/content.js",
    "./core/connectors": {
      "types": "./core/connectors.d.ts",
      "import": "./core/connectors.js"
    },
    "./core/id": "./core/id.js",
    "./core/inline-link": {
      "types": "./core/inline-link.d.ts",
      "import": "./core/inline-link.js"
    },
    "./core/inline-reference": {
      "types": "./core/inline-reference.d.ts",
      "import": "./core/inline-reference.js"
    },
    "./core/image-service": {
      "types": "./core/image-service.d.ts",
      "import": "./core/image-service.js"
    },
    "./core/media": "./core/media.js",
    "./core/slug": "./core/slug.js",
    "./content": {
      "types": "./content/index.d.ts",
      "import": "./content/index.js"
    },
    "./content/fs": {
      "types": "./content/fs.d.ts",
      "import": "./content/fs.js"
    }
  },
  "bin": {
    "minicms": "./bin/minicms.mjs"
  },
  "scripts": {
    "build": "node ./bin/minicms.mjs build",
    "check:bundle": "node ./ci/verify-bundle.mjs",
    "dev": "node ./bin/minicms.mjs dev",
    "test": "node ./bin/minicms.mjs test"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@blocknote/core": "^0.52.1",
    "@blocknote/mantine": "^0.52.1",
    "@blocknote/react": "^0.52.1",
    "@dnd-kit/core": "^6.3.1",
    "@mantine/core": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@vitejs/plugin-react": "^4.4.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-select": "^5.10.2",
    "sass": "^1.102.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
